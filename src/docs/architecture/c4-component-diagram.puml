@startuml component_diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

Person(user, "User", "Runs preprocessing and explores microservice runtime relationships")
System_Ext(browser, "Web Browser", "Renders Dash UI")
System_Ext(dash_libs, "Dash / Plotly / Cytoscape libs", "Python packages")

System_Boundary(sys, "Microservice Data Visualization") {
  Component(entrypoint, "app.py", "Python", "Runnable wrapper that calls msviz.cli.main")
  Container_Boundary(app_container, "Python Application") {
    Component(cli, "cli", "Python", "Top-level CLI with commands: serve, preprocess, preprocess_static")
    
    Container_Boundary(viz_pkg, "Visualization Package (msviz.visualization)") {
      Component(viz_factory, "app_factory", "Python", "Creates Dash app and wires visualization components")
      Component(viz_layout, "layout", "Python", "Defines page layout, tabs and modals")
      Component(viz_callbacks, "callbacks", "Python", "Handles UI events and filtering")
      Component(viz_graphs, "graphs", "Python", "Builds Cytoscape elements and Plotly figures")
      Component(viz_data, "data", "Python", "Loads runtime dataset and builds context")
      Component(viz_styles, "styles", "Python", "Defines Cytoscape stylesheet")
    }

    Container_Boundary(prep_pkg, "Preprocessing Package (msviz.preprocessing)") {
      Component(prep_pipeline, "pipeline", "Python", "Runtime preprocessing orchestration")
      Component(prep_steps, "steps", "Python", "Runtime transform steps (filter, enrich, prune)")
      Component(static_pipeline, "static_pipeline", "Python", "Static preprocessing orchestration")
      Component(prep_io, "io", "Python", "Input/output and path resolution for runtime + static preprocessing")

      Container_Boundary(parse_pkg, "Parser Subpackage (msviz.parsers)") {
        Component(product_config_parser, "product_config_parser", "Python", "Extracts microservices and metadata from Product config YAML")
        Component(cpp_symbol_parser, "cpp_symbol_parser", "Python", "Extracts package and function symbols from per-service JSON")
      }
    }
    
    Container_Boundary(data_pkg, "Data Package (msviz.data)") {
      Component(static_models, "static_models", "Python", "StaticDataModel and StaticPreprocessResult dataclasses")
    }
  }

  ContainerDb(raw_runtime_csv, "Raw Runtime CSV", "CSV file", "Unprocessed trace/event input data")
  ContainerDb(processed_runtime_csv, "Processed Runtime CSV", "CSV file", "Runtime dataset used by visualization")
  ContainerDb(service_config_yml, "Service Config YAML", "YAML file", "Product config file (service definitions)")
  ContainerDb(symbol_graph_json, "Symbol Graph JSON files", "JSON files", "Per-service symbol data")
  ContainerDb(processed_static_csv, "Processed Static CSV", "CSV file", "Normalized static entities: name, type, properties")
}

Rel(user, cli, "Runs commands", "CLI")
Rel(user, browser, "Uses")
Rel(browser, cli, "HTTP requests", "Dash server via serve/run")
Rel(entrypoint, cli, "Invokes")

Rel(cli, prep_pipeline, "Invokes", "preprocess")
Rel(cli, static_pipeline, "Invokes", "preprocess_static")
Rel(cli, viz_factory, "Invokes", "serve")

Rel(prep_pipeline, prep_steps, "Runs step sequence")
Rel(prep_pipeline, prep_io, "Uses read/write helpers")
Rel(prep_io, raw_runtime_csv, "Reads")
Rel(prep_io, processed_runtime_csv, "Writes")

Rel(static_pipeline, prep_io, "Uses read/write helpers")
Rel(static_pipeline, product_config_parser, "Uses")
Rel(static_pipeline, cpp_symbol_parser, "Uses")
Rel(static_pipeline, static_models, "Builds")
Rel(prep_io, service_config_yml, "Reads")
Rel(prep_io, symbol_graph_json, "Reads")
Rel(prep_io, processed_static_csv, "Writes")

Rel(viz_factory, viz_data, "Loads data and context")
Rel(viz_factory, viz_layout, "Builds layout")
Rel(viz_factory, viz_callbacks, "Registers callbacks")
Rel(viz_layout, viz_styles, "Applies stylesheet")
Rel(viz_callbacks, viz_graphs, "Builds figures and graph elements")
Rel(viz_data, processed_runtime_csv, "Reads")

Rel(viz_factory, dash_libs, "Uses")
Rel(viz_layout, dash_libs, "Uses")
Rel(viz_callbacks, dash_libs, "Uses")
Rel(viz_graphs, dash_libs, "Uses")

SHOW_LEGEND()
@enduml
